{
  "name": "fractal-git",
  "version": "0.1.0",
  "description": "Agent-native fractal git engine: lockless in-memory index, CAS snapshot materialization, and self-similar worktree reclamation.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "cargo build --release",
    "gate:topology": "node scripts/common/validate-crate-topology.js",
    "gate:parity": "node scripts/common/validate-git-parity.js",
    "gate:bridge": "node scripts/common/validate-gate-bridge.js",
    "gate:alloc": "node scripts/common/check-zero-alloc-boundary.js",
    "gate:rust": "node scripts/common/validate-crate-topology.js && cargo test --workspace",
    "gate": "npm run gate:topology && npm run gate:parity && npm run gate:bridge && npm run gate:alloc && npm test",
    "audit": "node scripts/common/run-audit-report.js",
    "review": "npm run audit",
    "test": "npm run test:ts",
    "test:rust": "cargo test --workspace",
    "test:ts": "node --test dist/tests/ts/*.test.js"
  },
  "keywords": [
    "git",
    "fractal-git",
    "multi-agent",
    "vfs",
    "cas",
    "praxis"
  ],
  "author": "Google DeepMind Advanced Agentic Coding Pair",
  "license": "MIT"
}
