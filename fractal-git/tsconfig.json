{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "../auto-refactor/node_modules/@types"
    ]
  },
  "include": [
    "ts/**/*",
    "tests/ts/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "target"
  ]
}
