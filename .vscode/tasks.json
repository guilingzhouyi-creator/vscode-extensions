{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "npm: watch - workspace-timing",
            "type": "npm",
            "script": "watch",
            "path": "workspace-timing",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "npm: compile - workspace-timing",
            "type": "npm",
            "script": "compile",
            "path": "workspace-timing",
            "problemMatcher": "$tsc",
            "group": "build"
        },
        {
            "label": "staggered-push: daemon",
            "type": "shell",
            "command": "node scripts/common/staggered-push-daemon.js",
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "close": true
            }
        },
        {
            "label": "auto-audit: async daemon",
            "type": "shell",
            "command": "node scripts/common/async-auto-audit-daemon.js",
            "isBackground": true,
            "problemMatcher": [],
            "runOptions": {
                "runOn": "folderOpen"
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared",
                "close": true
            }
        }
    ]
}
