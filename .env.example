# Codex / OpenAI API 地址与代理端点
CODEX_BASE_URL=https://www.mcgrox.top/v1
OPENAI_BASE_URL=https://www.mcgrox.top/v1
OPENAI_API_BASE=https://www.mcgrox.top/v1

# Codex / OpenAI API 访问密钥 (脱敏示例)
CODEX_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
