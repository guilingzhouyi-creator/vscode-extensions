{
  "$schema": "./auto-refactor/config.schema.json",
  "format": "text",
  "failOnIssue": false,
  "commentLevel": "standard",
  "autoTuneScale": true,
  "include": [
    "scripts/**/*.js",
    "auto-refactor/src/**/*.ts",
    "workspace-timing/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".git",
    "dist",
    "build",
    "out",
    "coverage",
    "testdata",
    "archive",
    ".audit-logs"
  ],
  "thresholds": {
    "magicNumberMin": 3,
    "duplicateLiteralThreshold": 4,
    "hardcodedStringMinLength": 4,
    "fileLinesWarn": 400,
    "fileLinesFail": 1400,
    "effectiveLocWarn": 750,
    "effectiveLocFail": 900,
    "fileFunctionsWarn": 20,
    "complexityWarn": 15,
    "complexityFail": 25,
    "blockingIoAllowPatterns": [
      "scripts/**",
      "tests/**",
      "src/cli/**",
      "auto-refactor/scripts/**",
      "auto-refactor/src/cli/**"
    ],
    "allocationAllowPatterns": [
      "scripts/**",
      "tests/**",
      "src/cli/**",
      "auto-refactor/scripts/**",
      "auto-refactor/src/cli/**"
    ]
  },
  "analyzers": {
    "constants": {
      "enabled": true
    },
    "complexity": {
      "enabled": true
    },
    "large-file": {
      "enabled": true
    },
    "governance": {
      "enabled": true
    }
  }
}
