{
  "_meta": {
    "version": 1,
    "domain": "world_gateway",
    "description": "世界栏网关与单联机模式隔离配置表"
  },
  "gateway_policy": {
    "auto_enter_gateway_on_login": true,
    "allow_direct_world_bypass": false,
    "session_timeout_seconds": 3600,
    "require_probe_refresh_on_exit": true,
    "block_hot_swap_while_world_active": true,
    "err_hot_swap_blocked": "ERR_HOT_SWAP_BLOCKED_IN_ACTIVE_WORLD"
  },
  "gateway_modes": {
    "available_modes": [
      1,
      2
    ]
  },
  "gateway_hooks": {
    "on_gateway_entered": [
      "prepare_slot_catalog"
    ],
    "on_mode_selected": [
      "bind_slot_context"
    ],
    "on_world_entered": [
      "trigger_initial_hud_sync"
    ]
  },
  "single_player": {
    "default_world_id": "",
    "default_slot_id": "SLOT_SP_01",
    "max_slots_baseline": 1,
    "max_worlds_baseline": 1
  },
  "local_archive": {
    "root_dir": "user://worlds/sp/",
    "catalog_file": "world_catalog.json",
    "max_worlds": 10
  },
  "probe_policy": {
    "sp_disk_check": true,
    "mp_heartbeat_timeout_ms": 3000,
    "mp_simulated_ping_ms": 24,
    "allow_offline_bypass": false,
    "maintenance_mode": false
  },
  "canary_features": {
    "FEATURE_MULTI_SLOT": {
      "strategy": "PERCENTAGE_CANARY",
      "rollout_percentage": 0,
      "whitelist": [
        "DEV_TESTER_01",
        "QA_AUDITOR_02"
      ]
    },
    "FEATURE_MULTI_WORLD": {
      "strategy": "GLOBAL_DISABLED",
      "rollout_percentage": 0,
      "whitelist": []
    },
    "FEATURE_MULTIPLAYER_GATEWAY": {
      "strategy": "WHITELIST_ONLY",
      "rollout_percentage": 0,
      "whitelist": [
        "MP_TESTER_01"
      ]
    }
  },
  "worlds_catalog": {}
}
