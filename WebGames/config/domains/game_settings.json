      "show_damage_numbers": true,
      "damage_text_scale": 1.0,
      "screen_shake_intensity": 1.0
    },
    "render": {
      "window_mode": "EXCLUSIVE_FULLSCREEN",
      "resolution_width": 1920,
      "resolution_height": 1080,
      "vsync_mode": "ENABLED",
      "target_fps_cap": 60,
      "msaa_level": "MSAA_4X",
      "shadow_quality": "HIGH",
      "glow_bloom_enabled": true,
      "particle_density": 1.0
    }
