{
  "apply": {
    "revert_timeout_seconds": 15.0
  },
  "audio": {
    "min_volume": 0.0,
    "max_volume": 1.0
  },
  "ui": {
    "min_scale": 0.75,
    "max_scale": 2.0,
    "default_scale": 1.0
  },
  "render": {
    "default_width": 1920,
    "default_height": 1080,
    "min_width": 640,
    "min_height": 480,
    "fallback_width": 1280,
    "fallback_height": 720
  },
  "defaults": {
    "audio": {
      "master_volume": 1.0,
      "bgm_volume": 0.8,
      "sfx_volume": 0.9,
