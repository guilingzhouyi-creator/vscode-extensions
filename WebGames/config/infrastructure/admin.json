  "salt": "KALAR_GM_SALT",
  "passkeys": [
    "a52662cab5471da9969bc64b5136797b20a7bb6f6b68e6e8d2543c779e769efe",
    "81fd86a6bf971908efcd416617c69aac97461758de663dbd2ccf4c33cc658ab8"
  ],
  "sandbox": {
    "give_gold_default": 10000,
