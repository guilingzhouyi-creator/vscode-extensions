{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kalar.mod_sdk.world_topology.v1",
  "title": "WorldTopologyDefinition",
  "description": "WebGames 世界档案目录、大地图地标与区域节点拓扑扩展契约规范",
  "type": "object",
  "properties": {
    "override_mode": {
      "type": "string",
      "enum": ["MERGE", "REPLACE_ENTRY", "TOTAL_PURGE"],
      "default": "MERGE"
    },
    "worlds_catalog": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "world_id": { "type": "string", "minLength": 1 },
              "world_name": { "type": "string", "minLength": 1 },
              "mode": { "type": ["string", "integer"] },
              "desc": { "type": "string" }
            },
            "required": ["world_id", "world_name"]
          }
        },
        {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      ],
      "description": "官方或自定义可进入世界档案列表或字典"
    },
    "birth_regions": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        { "type": "object", "additionalProperties": { "type": "object" } }
      ],
      "description": "可选创角降生大区列表或字典"
    },
    "landmarks": {
      "type": "array",
      "description": "大地图与定居点地标节点数组",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "loc_name_key": { "type": "string" },
          "continent_id": { "type": "string" },
          "terrain_type": { "type": "string" }
        },
        "required": ["id"]
      }
    },
    "map_id": { "type": "string" },
    "nodes": { "type": "array" },
    "edges": { "type": "array" }
  },
  "additionalProperties": true
}
