{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kalar.mod_sdk.dag_graph.v1",
  "title": "DagGraphDefinition",
  "description": "卡拉尔世界引擎 剧情有向无环图 (DAG) 拓扑与因果节点契约规范 (dag_graphs/DAG_*.json)",
  "type": "object",
  "properties": {
    "dag_id": {
      "type": "string",
      "pattern": "^DAG_[A-Z0-9_]+$",
      "description": "剧情有向图全局唯一标识符（如 DAG_FRONTIER_AWAKEN）"
    },
    "graph_id": {
      "type": "string",
      "pattern": "^DAG_[A-Z0-9_]+$",
      "description": "dag_id 的别名字段"
    },
    "entry_node_id": {
      "type": "string",
      "description": "序章剧情起始入口节点标识符（对应 START_ENTRY 节点）"
    },
    "terminal_node_id": {
      "type": "string",
      "description": "序章剧情主终结退出节点标识符（对应 TERMINAL_EXIT 节点）"
    },
    "nodes": {
      "type": "object",
      "minProperties": 2,
      "description": "拓扑图包含的因果剧情节点字典，键为节点唯一 ID",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "node_type": {
            "type": "string",
            "enum": [
              "START_ENTRY",
              "STANDARD_STEP",
              "BRANCH_CHOICE",
              "TERMINAL_EXIT"
            ],
            "description": "节点拓扑功能类型：START_ENTRY(入口，入度0), STANDARD_STEP(顺序步进), BRANCH_CHOICE(分支选择，出度>=2), TERMINAL_EXIT(终态退出，出度0)"
          },
          "narrative_key": {
            "type": "string",
            "description": "剧情本地化文案键名（在 i18n 字典中检索翻译）"
          },
          "inline_text": {
            "oneOf": [
              {
                "type": "string",
                "description": "单语言直接内联文本（支持白名单占位符插值）"
              },
              {
                "type": "object",
                "additionalProperties": { "type": "string" },
                "description": "多语言内联文本字典（如 {\"zh-CN\": \"...\", \"en-US\": \"...\"}）"
              }
            ],
            "description": "节点内联剧情文案语法糖，存在时可免除 i18n 键配置"
          },
          "required_prerequisites": {
            "type": "array",
            "items": { "type": "string" },
            "default": [],
            "description": "激活本节点必须已抵达并完成的前置上游节点 ID 列表"
          },
          "mutations_on_complete": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "CharacterCreated",
                    "LocationAssigned",
                    "EquipmentGranted",
                    "DialogueReady",
                    "PrologueCompleted"
                  ],
                  "description": "合规状态突变事件类型"
                }
              },
              "required": ["type"],
              "additionalProperties": true
            },
            "default": [],
            "description": "当节点被推演执行完毕时触发派发的状态突变事件列表"
          }
        },
        "required": ["node_type"]
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "description": "因果拓扑有向边清单",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "起始源节点 ID"
          },
          "from_node_id": {
            "type": "string",
            "description": "from 的别名字段"
          },
          "to": {
            "type": "string",
            "description": "指向目标节点 ID"
          },
          "to_node_id": {
            "type": "string",
            "description": "to 的别名字段"
          },
          "label": {
            "type": "string",
            "description": "分支选择显示标签文案（在 BRANCH_CHOICE 节点作为选项文案展示）"
          },
          "condition": {
            "type": "string",
            "description": "分支流转门槛判定表达式或逻辑断言"
          }
        },
        "anyOf": [
          { "required": ["from", "to"] },
          { "required": ["from_node_id", "to_node_id"] }
        ]
      }
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "additionalProperties": true
}
