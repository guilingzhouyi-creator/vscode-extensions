  "skills": {
    "algorithmic-operator-engineering": {
      "layer": "universal-methodology",
      "pitch": "当涉及算法瓶颈、吞吐优化、高频循环热路径或数据表示反转(SoA)时触发。执行五步降维协议与100%差分等价基准验证。",
      "purpose": "为算法与高频算子确立从数据表示到单趟融合的降维路径，并用差分基准与微基准证明收益真实存在。",
      "triggers": [
        "算子",
        "热路径",
        "吞吐优化",
        "降维",
        "SoA",
        "LUT",
        "基准等价",
        "卡顿"
      ],
      "situations": [
        "这个算子跑到百万级输入就卡住了，能降阶吗？",
        "别只改循环，把对象图反转成 TypedArray 试试。",
        "优化完要跑差分基准证明字节级等价，不许拍脑袋。"
      ],
      "verification": [
        "node auto-refactor/scripts/bench-hot-paths.js",
        "cd auto-refactor && npm run build && npm test",
        "node scripts/common/evaluate-eloc-budget.js"
      ]
    },
    "auto-refactor-dev": {
      "layer": "domain-adapter",
      "pitch": "开发、修改或测试 auto-refactor 项目代码时必须使用。看守 Rust 与 TS 双轨 100% 字节等价、四阶段流水线拓扑、Diff 引擎与暂存落盘规范。",
      "purpose": "回答『改引擎会不会破坏双轨等价与流水线拓扑』，产出分析器与规则改动及回归结论。",
      "triggers": [
        "auto重构",
        "分析器",
        "内核",
        "Praxis",
        "重构引擎",
        "双轨等价",
        "流水线"
      ],
      "situations": [
        "新增一个第二阶段分析器规则",
        "Rust 与 TS 实现的 Diff 输出不一致",
        "Praxis SDK 客户端协议要改签名"
      ],
      "verification": [
        "cd auto-refactor && npm run build && npm run gate && npm test && node scripts/bench-hot-paths.js",
        "cd auto-refactor && npm test"
      ]
    },
    "batch-commit": {
      "layer": "workspace-governance",
      "pitch": "当准备提交代码、分批原子提交或审查 git commit 信息时必须使用。按 6 层拓扑拆解提交，拦截 6 类黑话禁词，执行离线门禁预审与原子提交闭环。",
      "purpose": "回答『这批改动如何拆成可独立回滚的提交』，产出分批清单与门禁预审结论。",
      "triggers": [
        "提交",
        "分批",
        "暂存",
        "commit",
        "git",
        "预审",
        "禁词",
        "原子提交"
      ],
      "situations": [
        "用户说『这些改动一起提交吧』但涉及 20 个文件",
        "提交信息被 commit-msg-gate 拦下",
        "需要为底层重构拆出可回滚的提交点"
      ],
      "verification": [
        "pwsh -File scripts/ps1/commit-msg-gate.ps1 <msg-file>",
        "pwsh -File scripts/ps1/pre-commit-gate.ps1",
        "pwsh -File scripts/ps1/audit-all.ps1"
      ]
    },
    "coding-craft": {
      "layer": "universal-methodology",
      "pitch": "编写、生成或审查任何代码时必须遵循。坚持命名即契约、显式失败语义、类型穷尽、最小接口暴露与单向依赖，对接 516 条 SSOT 规则。",
      "purpose": "在任何代码落笔时提供命名、失败语义、类型穷尽与依赖方向的工艺判据，守住函数级质量底线。",
      "triggers": [
        "写代码",
        "重构",
        "命名",
        "错误处理",
        "类型设计",
        "SSOT",
        "空捕获"
      ],
      "situations": [
        "我要新增一个导出函数，先确定命名和失败语义。",
        "这个 catch 是空的，还有一堆 as any，按判据重写。",
        "审查这段代码：导出面是不是过大了？"
      ],
      "verification": [
        "node scripts/common/validate-skills.js && node scripts/common/validate-family-contract.js",
        "node scripts/common/validate-rule-id-closure.js && node scripts/common/validate-docs-consistency.js",
        "node scripts/common/evaluate-eloc-budget.js && node scripts/common/validate-code-density.js --all"
      ]
    },
    "complexity-budget": {
      "layer": "universal-methodology",
      "pitch": "重构大文件、优化认知复杂度(CC<=15)、缩减嵌套深度(Depth<=4)或检查体积包络(ELOC<=900)时触发。落实六字段 JSDoc 契约与循环零堆分配。",
      "purpose": "在编码与重构中量化控制流复杂度、文件体积与注释密度，把超限模块压回刚性预算内。",
      "triggers": [
        "重构",
        "拆分文件",
        "CC",
        "Depth",
        "ELOC",
        "LOC",
        "JSDoc",
        "注水"
      ],
      "situations": [
        "这个文件 1200 行了，帮我拆到 ELOC 900 以内。",
        "这个函数 CC 21、嵌套 5 层，改成卫语句提前返回。",
        "循环里 new 了对象，按零瞬态堆分配改掉。"
      ],
      "verification": [
        "node scripts/common/evaluate-eloc-budget.js",
        "node auto-refactor/scripts/validate-comment-governance.js",
        "pwsh -File scripts/ps1/pre-commit-gate.ps1",
        "node scripts/common/validate-code-density.js --all"
      ]
    },
    "constraint-driven-development": {
      "layer": "universal-methodology",
      "pitch": "完成特性交付、声称修复完成或合入前对抗性证伪时必须触发。落实 Floor Guard 刚性底线与单调棘轮，主动推翻边界假设与脆弱实现。",
      "purpose": "在交割前用机器化底线与五步怀疑循环证伪改动，阻止阈值下调、测试弱化与半成品交付。",
      "triggers": [
        "交割",
        "验收",
        "证伪",
        "Doubt",
        "阈值下调",
        "测试弱化",
        "半成品"
      ],
      "situations": [
        "我准备声称修完了，交割前按五步怀疑循环证伪一遍。",
        "能不能先把 baseline 阈值下调让门禁过？",
        "这次改动语义量不到 15%，会被判刷分熔断吗？"
      ],
      "verification": [
        "pwsh -File scripts/ps1/audit-all.ps1"
      ]
    },
    "debugging-and-error-recovery": {
