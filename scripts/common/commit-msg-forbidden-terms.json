{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "commit-msg-forbidden-terms/v1",
  "version": "1.4.0",
  "rules": [
    {
      "id": "CMG-STY-001",
      "category": "temporary",
      "severity": "error",
      "title": "临时性与敷衍口吻词汇拦截",
      "patterns": [
        "临时",
        "暂存",
        "暂时",
        "凑合",
        "随便",
        "粗略",
        "先这样",
        "待处理",
        "后续再看",
        "占位",
        "随便改改",
        "打补丁",
        "临时方案",
        "草率"
      ],
      "asciiPatterns": [
        "\\b(wip|temp|tmp|quick\\s*fix|quick-and-dirty|hack|hacky|hacks|placeholder|placeholders|band-?aid|for\\s*now|tentative|provisional|ad-?hoc|stopgap|patchy|half-?baked|rough\\s*draft|casual\\s*commit)\\b"
      ],
      "reason": "提交说明是长期技术档案，严禁使用敷衍、临时性或未决用语替代客观技术事实。",
      "guidance": "请陈述当前具体的改动范围与已知边界，例如：'实现基础分支调度，暂未支持异步流'。"
    },
    {
      "id": "CMG-STY-002",
      "category": "hyperbolic_affirmative",
      "severity": "error",
      "title": "过度肯定与绝对化夸大表述拦截",
      "patterns": [
        "绝对",
        "彻底",
        "完美",
        "完美无瑕",
        "极致",
        "终极",
        "史无前例",
        "彻底解决",
        "完全消除",
        "永不",
        "绝不",
        "绝无",
        "100%",
        "工业级",
        "顶尖",
        "顶级",
        "天花板",
        "最强",
        "无懈可击",
        "超强",
        "万能",
        "零缺陷",
        "永不崩溃",
        "九重门禁",
        "9重防御",
        "九重防御",
        "案卷施工",
        "四阶段案卷",
        "规则金字塔"
      ],
      "asciiPatterns": [
        "\\b(flawless|perfect|perfection|ultimate|bulletproof|unbeatable|invincible|god-?tier|peerless|silver\\s*bullet|zero-?bug|industrial-?grade|enterprise-?grade|state-?of-?the-?art|best-?in-?class)\\b",
        "\\b(completely\\s*solved|fully\\s*eliminated|never\\s*fails?|absolutely\\s*(safe|correct|flawless))\\b",
        "\\b100%\\s*(safe|secure|fixed|working|reliable|guaranteed)\\b",
        "\\b(?:nine-fold|9-fold)\\s*(?:gates?|defense|defences?|guards?)\\b"
      ],
      "reason": "严禁使用绝对化、神话或过度肯定的商业宣扬词汇，技术陈述必须客观严谨。",
      "guidance": "请陈述具体的技术解决手段与覆盖用例，例如：'在配置解析前增加非空校验，规避缺少可选字段时的异常'。"
    },
    {
      "id": "CMG-STY-003",
      "category": "hyperbolic_negative",
      "severity": "error",
      "title": "过度否定与情绪化贬损表述拦截",
      "patterns": [
        "垃圾",
        "一团糟",
        "稀烂",
        "毫无意义",
        "彻底失败",
        "毫无价值",
        "致命缺陷",
        "严重崩溃",
        "烂代码",
        "废物",
        "稀碎"
      ],
      "asciiPatterns": [
        "\\b(rubbish|garbage|total\\s*crap|trash|shitty|horrible|terrible|worthless|complete\\s*mess|disaster|catastrophe|useless\\s*code|broken\\s*beyond\\s*repair|idiotic)\\b"
      ],
      "reason": "严禁在提交信息中夹带情绪化贬损或过度否定的非客观用语。",
      "guidance": "请客观说明待优化或重构的技术动因，例如：'重构深层循环嵌套以降低圈复杂度'。"
    },
    {
      "id": "CMG-STY-004",
      "category": "meta_narrative",
      "severity": "error",
      "title": "风格元叙事、口号与宣传套话拦截",
      "patterns": [
        "低调中肯",
        "求真务实",
        "宣扬性词汇",
        "移除宣扬性词汇",
        "调整文案语调",
        "风格升级",
        "实事求是",
        "语调优化",
        "拒绝浮夸",
        "自吹自擂",
        "标杆",
        "跨时代",
        "划时代",
        "重磅",
        "里程碑式",
        "突破性",
        "颠覆性",
        "重塑",
        "飞跃",
        "震撼",
        "史诗级",
        "跨越式",
        "全部PASS",
        "全部通过",
        "退出码0全部验证完毕",
        "门禁全部PASS",
        "全部验证完毕"
      ],
      "asciiPatterns": [
        "\\b(game-?changer|groundbreaking|paradigm\\s*shift|revolutionary|epoch-?making|monumental|quantum\\s*leap|milestone\\s*breakthrough)\\b",
        "\\b(tone\\s*down|low-?key|pragmatic|pragmatism|humble|stay\\s*humble|truth-?seeking|down-?to-?earth)\\b",
        "\\b(remove\\s*(boastful|promotional|hyped)\\s*(words?|vocabulary|terms?|language)?)\\b",
        "\\b(adjust(ing)?\\s*(the\\s*)?(tone|wording\\s*tone|writing\\s*style))\\b",
        "\\b(meta-?narrative|style\\s*refactoring|style\\s*upgrade|factual\\s*and\\s*pragmatic)\\b",
        "\\b(?:all\\s*(?:gates?\\s*)?pass(?:ed)?|exit\\s*code\\s*0\\s*(?:all\\s*)?verified)\\b"
      ],
      "reason": "严禁将治理要求、自省表态或文风口号当作改动正文提交（无论中英文），提交说明必须纯粹记录技术改动事实。",
      "guidance": "请直接列出修改的具体文件与小节内容，例如：'更新 README.md 中各项目状态标注，说明部分模块仍处于探索与未完成阶段'。"
    },
    {
      "id": "CMG-STY-005",
      "category": "procedural_boilerplate",
      "severity": "error",
      "title": "程序化流水账与形式主义元叙事拦截",
      "patterns": [
        "退出码0",
        "退出码 0",
        "返回退出码",
        "均返回",
        "双端返回",
        "双端脚本均返回",
        "返回0",
        "返回 0",
        "无报错",
        "运行完成",
        "正常状态",
        "项检查",
        "项自检",
        "大项",
        "套测试",
        "套套件",
        "套并行",
        "项自测",
        "全部通过",
        "套件通过",
        "检查通过"
      ],
      "asciiPatterns": [
        "\\b(?:exit|return)\\s*(?:code\\s*)?0\\b",
        "\\bexit\\s*status\\s*0\\b",
        "\\bwithout\\s*errors?\\b",
        "\\b\\d+\\s*(?:tests?|suites?|items?|checks?)\\s*pass(?:ed)?\\b",
        "\\ball\\s*\\d*\\s*(?:checks?|tests?|suites?)\\s*pass(?:ed)?\\b"
      ],
      "reason": "提交说明是长期技术档案，[Verification] 区块严禁使用'退出码0'、'双端返回0'、'XX项检查通过'等程序化流水账替代具体输入输出与断言细节。",
      "guidance": "请陈述具体的验证边界用例、输入参数与功能断言，例如：'运行 node scripts/test-parallel.js，断言 4 个 Rust 嵌入式测试用例与 9 个量化维度路由断言成立'。"
    },
    {
      "id": "CMG-STY-006",
      "category": "execution_numeric_forbidden",
      "severity": "error",
      "title": "执行标签区域零执行数字纪律",
      "patterns": [],
      "asciiPatterns": [],
      "reason": "提交说明是长期技术档案，执行标签区域（[Verification]）下严禁记录任何形式的执行数字、用例计数、测试套件数、行数、耗时、比例或百分比流水账。",
      "guidance": "必须将执行结论提炼为纯粹的技术功能逻辑与输入输出断言事实描述，彻底移除所有执行数字与量词。例如将'断言419个文件通过'改为'断言全量源码文件合规'。"
    }
  ],
  "whitelist": [
    "绝对路径",
    "绝对地址",
    "绝对值",
    "绝对像素尺寸",
    "绝对坐标",
    "绝对定位",
    "临时文件",
    "临时目录",
    "临时表",
    "临时对象",
    "临时缓冲区",
    "临时变量",
    "临时存储",
    "全量编译",
    "全量检查点",
    "完全限定名",
    "垃圾回收",
    "absolute path",
    "absolute address",
    "absolute value",
    "absolute coordinate",
    "absolute position",
    "temp file",
    "temporary file",
    "temporary directory",
    "temporary table",
    "temporary object",
    "temporary buffer",
    "temporary variable",
    "temporary storage",
    "full build",
    "full checkpoint",
    "garbage collection",
    "garbage collector",
    "garbage-collected",
    "garbage-collection",
    "quick fix action",
    "quick-fix action",
    "format placeholder",
    "template placeholder",
    "parameter placeholder",
    "empty placeholder",
    "placeholder node",
    "placeholder pattern",
    "placeholder bag",
    "placeholder archive",
    "vacuous placeholder",
    "positional placeholder",
    "暂存区",
    "暂存切片",
    "staging area",
    "占位符",
    "two-pass",
    "multi-pass",
    "single-pass",
    "pass by value",
    "pass by reference",
    "pass parameter",
    "pass parameters",
    "pass argument",
    "pass arguments",
    "pass through",
    "pass-through",
    "passing parameter",
    "passing parameters",
    "passing argument",
    "passing arguments",
    "passing options",
    "message passing"
  ]
}

