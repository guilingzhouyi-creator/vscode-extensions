{
  "schema": "diff-bounds-contract/v1",
  "description": "Single source of truth for weighted ELOC differential envelopes, TSPR thresholds, deletion turnover weight, test-file track, cross-file refactor conservation, and Jeffreys Beta(0.5, 0.5) empirical admission.",
  "fileAddBands": {
    "newFile": {
      "floor": 0,
      "target": 160,
      "ceiling": 240
    },
    "existingFile": {
      "floor": 0,
      "target": 90,
      "ceiling": 180
    },
    "refactorWitness": {
      "floor": 0,
      "target": 140,
      "ceiling": 260
    }
  },
  "testFileAddBands": {
    "newFile": {
      "floor": 0,
      "target": 240,
      "ceiling": 360
    },
    "existingFile": {
      "floor": 0,
      "target": 150,
      "ceiling": 260
    },
    "refactorWitness": {
      "floor": 0,
      "target": 240,
      "ceiling": 380
    }
  },
  "fileDelBands": {
    "plain": {
      "floor": 0,
      "target": 60,
      "ceiling": 120
    },
    "witnessed": {
      "floor": 0,
      "target": 180,
      "ceiling": 360
    }
  },
  "expansionPolicy": {
    "defaultFileLocBudget": 900,
    "minExpansionAllowanceLoc": 60,
    "maxExpansionLocRatio": 0.35,
    "minDeletionAllowanceLoc": 10,
    "maxDeletionFractionErosion": 0.4,
    "refactorWitnessMinDelEloc": 10,
    "witnessCoverageRatio": 0.7,
    "crossFileRefactorMinDelEloc": 30,
    "crossFileRefactorDelRatio": 0.6
  },
  "densityBands": {
    "minPhysAddSampleWidth": 10,
    "substantiveRatio": {
      "floor": 0.45,
      "target": 0.6,
      "hardCeiling": 0.85
    },
    "tspr": {
      "floor": 0.3,
      "target": 0.4,
      "hardCeiling": 0.75
    },
    "tsprVouchForDensity": 0.85
  },
  "batchBands": {
    "add": {
      "floor": 0,
      "target": 360,
      "ceiling": 540
    },
    "del": {
      "floor": 0,
      "target": 180,
      "ceiling": 360
    },
    "refactorWitnessAddCeiling": 720,
    "deletionTurnoverWeight": 0.8,
    "testBatchWeight": 0.5
  },
  "empiricalAdmission": {
    "turnoverFloor": 3.0,
    "turnoverCap": 25.0,
    "minTrajectorySamples": 3,
    "trajectoryWindowSize": 20,
    "jeffreysPriorAlpha": 0.5,
    "jeffreysPriorBeta": 0.5,
    "jeffreysDefaultPosterior": 0.5,
    "stdDevDiscountFactor": 0.5,
    "maxNoiseCeiling": 4.0
  },
  "ledgers": {
    "taxisRelative": ".taxis/telemetry/admission_ledger.ndjson",
    "taxisLegacyRelative": ".git/telemetry/admission_ledger.ndjson",
    "autoRefactorRelative": ".auto-refactor-cache/admission-turnover-ledger.ndjson"
  }
}
