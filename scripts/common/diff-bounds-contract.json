{
  "schema": "diff-bounds-contract/v1",
  "description": "Single source of truth for 5D ELOC differential envelopes, TSPR thresholds, deletion turnover weight, existing-file refactor witness relaxation, and Jeffreys Beta(0.5, 0.5) empirical admission.",
  "fileAddBands": {
    "newFile": {
      "floor": 0,
      "target": 120,
      "ceiling": 180
    },
    "existingFile": {
      "floor": 0,
      "target": 60,
      "ceiling": 120
    },
    "refactorWitness": {
      "floor": 0,
      "target": 90,
      "ceiling": 180
    }
  },
  "fileDelBands": {
    "plain": {
      "floor": 0,
      "target": 50,
      "ceiling": 100
    },
    "witnessed": {
      "floor": 0,
      "target": 140,
      "ceiling": 280
    }
  },
  "expansionPolicy": {
    "defaultFileLocBudget": 900,
    "minExpansionAllowanceLoc": 60,
    "maxExpansionLocRatio": 0.35,
    "minDeletionAllowanceLoc": 10,
    "maxDeletionFractionErosion": 0.4,
    "refactorWitnessMinDelEloc": 10,
    "witnessCoverageRatio": 0.7
  },
  "densityBands": {
    "minPhysAddSampleWidth": 10,
    "substantiveRatio": {
      "floor": 0.45,
      "target": 0.6,
      "hardCeiling": 0.85
    },
    "tspr": {
      "floor": 0.3,
      "target": 0.4,
      "hardCeiling": 0.75
    },
    "tsprVouchForDensity": 0.85
  },
  "batchBands": {
    "add": {
      "floor": 0,
      "target": 240,
      "ceiling": 360
    },
    "del": {
      "floor": 0,
      "target": 140,
      "ceiling": 280
    },
    "deletionTurnoverWeight": 0.8
  },
  "empiricalAdmission": {
    "turnoverFloor": 3.0,
    "turnoverCap": 25.0,
    "minTrajectorySamples": 3,
    "trajectoryWindowSize": 20,
    "jeffreysPriorAlpha": 0.5,
    "jeffreysPriorBeta": 0.5,
    "jeffreysDefaultPosterior": 0.5,
    "stdDevDiscountFactor": 0.5,
    "maxNoiseCeiling": 4.0
  },
  "ledgers": {
    "taxisRelative": ".git/telemetry/admission_ledger.ndjson",
    "autoRefactorRelative": ".auto-refactor-cache/admission-turnover-ledger.ndjson"
  }
}
