{
  "name": "workspace-governance",
  "version": "0.0.0",
  "private": true,
  "description": "Root-level gate orchestration for the multi-project workspace",
  "scripts": {
    "gate:install": "pwsh -File scripts/ps1/install-hooks.ps1",
    "gate:precommit": "pwsh -File scripts/ps1/pre-commit-gate.ps1",
    "gate:prepush": "pwsh -File scripts/ps1/pre-push-gate.ps1",
    "gate:audit": "pwsh -File scripts/ps1/audit-all.ps1",
    "gate:rules": "node scripts/common/generate-rule-catalog.js --check-only",
    "gate:closure": "node scripts/common/validate-rule-id-closure.js",
    "gate:docs": "node scripts/common/validate-docs-consistency.js",
    "gate:reach": "node scripts/common/validate-rule-reachability.js",
    "gate:parity": "node scripts/common/test-gate-parity.js",
    "gate:selftest": "node scripts/common/test-gate-selftest.js",
    "gate:bootstrap": "node scripts/common/bootstrap-gates.js"
  }
}
