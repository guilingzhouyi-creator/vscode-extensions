#!/usr/bin/env bash
# Git Post-Commit Hook — 落盘 HEAD 门禁收据（--no-verify 下仍会触发，是唯一绕过落点）
set -euo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT_DIR" ]] || exit 0
node "$ROOT_DIR/scripts/common/gate-receipts.js" finalize --ppid "$PPID" --hook post-commit || true
exit 0
