#!/usr/bin/env bash
# Git Commit-Msg Hook — 智能双运行期路由 (pwsh / bash) + 门禁收据阶段标记
set -euo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1 && [[ -f "$ROOT_DIR/scripts/ps1/commit-msg-gate.ps1" ]]; then
    pwsh -File "$ROOT_DIR/scripts/ps1/commit-msg-gate.ps1" "$1" || exit 1
else
    bash "$ROOT_DIR/scripts/sh/commit-msg-gate.sh" "$1" || exit 1
fi
node "$ROOT_DIR/scripts/common/gate-receipts.js" mark --phase commit-msg --ppid "$PPID"
