#!/usr/bin/env bash
# Git Post-Merge Hook — 为合并产生的提交落盘门禁收据（合并不会触发 post-commit）
set -euo pipefail
ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$ROOT_DIR" ]] || exit 0
node "$ROOT_DIR/scripts/common/gate-receipts.js" finalize --ppid "$PPID" --hook post-merge >/dev/null 2>&1 || true
exit 0
