root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.ts]
indent_size = 4

[*.ps1]
end_of_line = crlf

[*.png]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[*.vsix]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
