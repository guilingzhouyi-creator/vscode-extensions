{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SubagentPostureSchema",
  "description": "Schema for workspace subagent action posture configurations",
  "type": "object",
  "required": [
    "posture",
    "displayName",
    "model",
    "toolPermissions",
    "behaviorRules",
    "dshModes"
  ],
  "properties": {
    "posture": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "displayName": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "enum": ["inherit", "flash"]
    },
    "dshModes": {
      "type": "array",
      "minItems": 1,
      "description": "该姿态允许承载的 DSH 治理模式；装配模式时其姿态应出现在此列表内",
      "items": {
        "type": "string",
        "enum": ["wg-construct", "wg-refactor", "wg-review", "wg-explore"]
      }
    },
    "toolPermissions": {
      "type": "object",
      "required": [
        "enableWriteTools",
        "enableMcpTools",
        "enableSubagentTools"
      ],
      "properties": {
        "enableWriteTools": { "type": "boolean" },
        "enableMcpTools": { "type": "boolean" },
        "enableSubagentTools": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "behaviorRules": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "posture": { "enum": ["review", "explore"] }
        }
      },
      "then": {
        "properties": {
          "toolPermissions": {
            "properties": {
              "enableWriteTools": { "const": false }
            }
          }
        }
      }
    }
  ]
}
