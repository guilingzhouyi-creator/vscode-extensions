{
    "name": "workspace-timing",
    "displayName": "Workspace Timing",
    "description": "⏱ 全本地工作区时长追踪 — 自动计时 · 效率转化 · 闲置检测 · 每日目标 · 周报图表 · 跨工作区聚合 · 崩溃保护 · CSV导出 | Fully local workspace time tracker — auto timing, efficiency ratio, idle detection, daily goal, weekly charts, cross-workspace, crash protection, CSV export",
    "version": "0.3.6",
    "publisher": "guilingzhouyi",
    "license": "MIT",
    "icon": "images/icon.png",
    "gallery": [
        {
            "path": "images/banner.png",
            "description": "Dashboard 控制面板"
        }
    ],
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "workspaceTiming.enable",
                "title": "%workspaceTiming.enable%"
            },
            {
                "command": "workspaceTiming.disable",
                "title": "%workspaceTiming.disable%"
            },
            {
                "command": "workspaceTiming.toggleGlobal",
                "title": "%workspaceTiming.toggleGlobal%"
            },
            {
                "command": "workspaceTiming.showStatus",
                "title": "%workspaceTiming.showStatus%"
            },
            {
                "command": "workspaceTiming.reset",
                "title": "%workspaceTiming.reset%"
            },
            {
                "command": "workspaceTiming.debugSave",
                "title": "%workspaceTiming.debugSave%"
            },
            {
                "command": "workspaceTiming.openDashboard",
                "title": "%workspaceTiming.openDashboard%"
            },
            {
                "command": "workspaceTiming.newPeriod",
                "title": "%workspaceTiming.newPeriod%"
            }
        ],
        "configuration": {
            "title": "Workspace Timing",
            "properties": {
                "workspaceTiming.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable timing for the current workspace"
                },
                "workspaceTiming.globalDisabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "Globally disable timing for all workspaces"
                },
                "workspaceTiming.statusBar.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show timing in the status bar"
                },
                "workspaceTiming.statusBar.format": {
                    "type": "string",
                    "enum": [
                        "compact",
                        "detailed"
                    ],
                    "default": "compact",
                    "description": "Status bar display format"
                },
                "workspaceTiming.statusBar.clickAction": {
                    "type": "string",
                    "enum": [
                        "cycle",
                        "dashboard"
                    ],
                    "default": "cycle",
                    "description": "Status bar click: cycle display mode or open dashboard"
                },
                "workspaceTiming.storage.backupToFile": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable JSON file backup in .vscode/"
                },
                "workspaceTiming.storage.journalEnabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable journal file for crash protection"
                },
                "workspaceTiming.storage.ringBufferCapacity": {
                    "type": "number",
                    "default": 1024,
                    "minimum": 64,
                    "maximum": 65536,
                    "description": "RingBuffer capacity (number of time slices)"
                },
                "workspaceTiming.storage.journalFlushInterval": {
                    "type": "number",
                    "default": 10000,
                    "minimum": 1000,
                    "maximum": 300000,
                    "description": "Journal flush interval in ms"
                },
                "workspaceTiming.storage.fullSaveInterval": {
                    "type": "number",
                    "default": 60000,
                    "minimum": 5000,
                    "maximum": 600000,
                    "description": "Full save interval in ms"
                },
                "workspaceTiming.storage.maxSessions": {
                    "type": "number",
                    "default": 1000,
                    "minimum": 0,
                    "description": "Max session history entries (0 = unlimited)"
                },
                "workspaceTiming.efficiency.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Track editing activity for efficiency ratio (active typing time / timer)"
                },
                "workspaceTiming.idleTimeoutMinutes": {
                    "type": "number",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 120,
                    "description": "Idle timeout in minutes — pause timer after this much inactivity (0 = disabled)"
                },
                "workspaceTiming.dailyGoalMinutes": {
                    "type": "number",
                    "default": 360,
                    "minimum": 0,
                    "maximum": 1440,
                    "description": "Daily goal in minutes — show notification when reached (0 = disabled)"
                }
            }
        },
        "keybindings": [
            {
                "command": "workspaceTiming.toggleGlobal",
                "key": "ctrl+shift+t t"
            },
            {
                "command": "workspaceTiming.reset",
                "key": "ctrl+shift+t r"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && npm run copy-assets",
        "compile": "tsc -p ./",
        "copy-assets": "node -e \"var f=require('fs');f.cpSync('src/presentation/dashboard.html','out/presentation/dashboard.html');f.cpSync('src/presentation/dashboard.en.html','out/presentation/dashboard.en.html')\"",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "node ./out/test/runTest.js",
        "lint": "eslint src --ext ts"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "@types/node": "^20.11.0",
        "@types/mocha": "^10.0.6",
        "typescript": "^5.3.3",
        "eslint": "^8.56.0",
        "@typescript-eslint/eslint-plugin": "^6.19.0",
        "@typescript-eslint/parser": "^6.19.0",
        "mocha": "^10.3.0"
    }
}