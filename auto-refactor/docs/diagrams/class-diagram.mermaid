classDiagram
    class Scanner {
        +ScanConfig config
        +scan() Promise~ScanReport~
        +scanFiles(files) Promise~Issue[]~
        +scanDiff(input) Promise~ScanReport~
    }

    class DualTrackPipeline {
        +executeDualTrack(input) Promise~DualTrackResult~
    }

    class SparseMoEGateRouter {
        +getRoutingPlan(file, oldCode, newCode) SparseRoutingPlan
    }

    class SemanticGraph {
        +addSymbol(symbol) void
        +addEdge(edge) void
        +getBackwardImpact(file, symbol) string[]
    }

    class NativeBridge {
        +maskSourceCode(content, config) NativeMaskedSource
        +computeHistogramDiff(oldContent, newContent) NativeDiffHunk[]
        +analyzeDependencyGraph(edges) NativeGraphAnalysis
        +computeMinHash(content, perms) number[]
    }

    class QualityScorer {
        +evaluateQualityScore(issues, stats) QualityScoreAssessment
        +synthesizeEightPillars(indices) EightPillarBreakdown
    }

    class RiskFusionEngine {
        +evaluateIssue(staticRisk, dynamicRisk, history) FusedIssueRisk
        +fuseIssueRisks(staticRisk, dynamicRisk, factor) FusedIssueRisk
    }

    class AutonomyScorer {
        +evaluateProjectAutonomy(fileMetrics, issues, config) AutonomyEvaluation
        +computeBayesianAutonomyConfidence(score, loc, files) AutonomyConfidence
    }

    class PraxisDiffGovernanceService {
        +reviewDiff(input, options) Promise~PraxisDiffGovernanceResult~
        +enrichHunks(filePath, hunks, graph) ReviewDiffHunk[]
    }

    class PraxisReviewClient {
        +reviewWorkspace(options) Promise~PraxisWorkspaceReviewVerdict~
        +reviewFile(filePath, content, options) Promise~PraxisFileReviewVerdict~
        +reviewDiff(input, options) Promise~PraxisDiffGovernanceResult~
        +evaluateMergeGate(source, target, hunks) Promise~PraxisMergeGateVerdict~
    }

    Scanner --> DualTrackPipeline : orchestrates
    DualTrackPipeline --> SparseMoEGateRouter : routes analyzers
    Scanner --> SemanticGraph : projects AST
    Scanner --> NativeBridge : accelerates kernels
    Scanner --> QualityScorer : quantifies 10 dimensions
    Scanner --> RiskFusionEngine : fuses cross-plane risks
    Scanner --> AutonomyScorer : evaluates CAI 6-dim autonomy
    PraxisReviewClient --> Scanner : orchestrates review
    PraxisReviewClient --> PraxisDiffGovernanceService : delegates diff review
    PraxisReviewClient --> SemanticGraph : queries impact topology
