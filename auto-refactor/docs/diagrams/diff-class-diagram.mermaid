classDiagram
    class IPraxisReviewClient {
        <<interface>>
        +reviewWorkspace(options) Promise~PraxisWorkspaceReviewVerdict~
        +reviewFile(filePath, content, options) Promise~PraxisFileReviewVerdict~
        +reviewDiff(input, options) Promise~PraxisDiffGovernanceResult~
        +evaluateMergeGate(source, target, hunks) Promise~PraxisMergeGateVerdict~
    }

    class PraxisReviewClient {
        -SemanticGraph graph
        -IPraxisDiffGovernanceService diffService
        -IPraxisSliceAuditService sliceService
        -SparseMoEGateRouter sparseRouter
        +reviewWorkspace(options) Promise~PraxisWorkspaceReviewVerdict~
        +reviewFile(filePath, content, options) Promise~PraxisFileReviewVerdict~
        +reviewDiff(input, options) Promise~PraxisDiffGovernanceResult~
        +evaluateMergeGate(source, target, hunks) Promise~PraxisMergeGateVerdict~
        +clearSemanticGraph() void
    }

    class IPraxisPresentationService {
        <<interface>>
        +toPresentation(agentPrompt, options) PraxisPresentationPayload
        +fromSliceVerdict(verdict, target, options) PraxisPresentationPayload
        +fromScanReport(report, options) PraxisPresentationPayload
        +auditAndPresent(input, options, callGraph) Promise~PraxisPresentationPayload~
    }

    class PraxisPresentationAdapter {
        -IPraxisI18nProvider i18n
        +toPresentation(agentPrompt, options) PraxisPresentationPayload
        +fromSliceVerdict(verdict, target, options) PraxisPresentationPayload
        +fromScanReport(report, options) PraxisPresentationPayload
        +aggregateOverlappingCards(cards) PraxisDiagnosticCard[]
    }

    class IPraxisDiffGovernanceService {
        <<interface>>
        +reviewDiff(input, options) Promise~PraxisDiffGovernanceResult~
        +enrichHunks(filePath, hunks, graph) ReviewDiffHunk[]
        +createHooks(graph) PraxisPluginHooks
    }

    class IPraxisSliceAuditService {
        <<interface>>
        +auditSlice(input, callGraph) Promise~PraxisSliceAuditVerdict~
        +auditAgentSlice(input, callGraph) Promise~CompactAgentPrompt~
        +traceCallImpact(file, symbol, breaking, graph) CallChainImpactResult
    }

    class IPraxisMultiAgentGovernanceService {
        <<interface>>
        +reviewMultiAgentPatches(patches, options) Promise~PraxisMultiAgentGovernanceResult~
        +detectAgentCollisions(patches, baseEdges) AgentCollision[]
        +arbitrateCompetingPatches(patches) PatchArbitrationCandidate[]
    }

    class IPraxisTrajectoryLearningService {
        <<interface>>
        +learnFromTrajectory(input) Promise~PraxisTrajectoryVerdict~
        +detectRegressions(filePath, revisions) Issue[]
        +matchRecipes(code, language) RefactoringRecipe[]
    }

    class FeedbackAdaptiveSupervisor {
        +recordIncident(record) AdaptiveEvolutionStep
        +saveSnapshot(filePath) void
        +loadSnapshot(filePath) GovernanceLedgerSnapshot
    }

    class PraxisRollbackEngine {
        +recordCardHunk(cardId, filePath, content, hunk) void
        +revertCard(cardId) CardRollbackResult
        +revertDiffHunk(hunk) RevertedHunkResult
    }

    PraxisReviewClient ..|> IPraxisReviewClient : implements
    PraxisPresentationAdapter ..|> IPraxisPresentationService : implements
    PraxisReviewClient --> IPraxisDiffGovernanceService : delegates diff review
    PraxisReviewClient --> IPraxisSliceAuditService : delegates slice audit
    PraxisReviewClient --> IPraxisPresentationService : generates UI payloads
    IPraxisDiffGovernanceService ..> PraxisRollbackEngine : coordinates rollback
    IPraxisSliceAuditService ..> IPraxisDiffGovernanceService : escalates L3A
    IPraxisMultiAgentGovernanceService ..> PraxisRollbackEngine : triggers LIFO revert on collision
