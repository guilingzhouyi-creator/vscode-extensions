root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Workspace rule (AGENTS.md §4.1): TypeScript is 4-space; everything else is 2-space.
[*.ts]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2
