{
  "$schema": "./config.schema.json",
  "format": "text",
  "failOnIssue": false,

  "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.jsx"],
  "exclude": ["node_modules", ".git", "dist", "build", "out", "coverage", ".next", ".vscode-test"],

  "thresholds": {
    "magicNumberMin": 2,
    "duplicateLiteralThreshold": 3,
    "hardcodedStringMinLength": 3,
    "fileLinesWarn": 60,
    "fileLinesFail": 120,
    "fileFunctionsWarn": 6,
    "complexityWarn": 8,
    "complexityFail": 12
  },

  "analyzers": {
    "constants": { "enabled": true, "options": {} },
    "large-file": { "enabled": true, "options": {} },
    "complexity": { "enabled": true, "options": {} }
  },

  "customAnalyzers": [],

  "logLevel": "info",
  "logFile": null,
  "concurrency": 4,
  "workers": 0,
  "respectGitignore": true,
  "failOnAnalyzerError": false
}
