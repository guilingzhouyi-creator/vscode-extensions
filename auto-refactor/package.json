{
  "name": "auto-refactor",
  "version": "0.4.0",
  "description": "Configurable, extensible automated code-refactoring analyzer: constant extraction, large-file splitting, and cyclomatic complexity — with CI-ready structured output (JSON / SARIF / text). Declarative, pluggable, project-agnostic.",
  "bin": {
    "auto-refactor": "dist/index.js"
  },
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "require": "./dist/api.js"
    },
    "./config.schema.json": "./config.schema.json",
    "./report.schema.json": "./report.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "node scripts/build-native.js",
    "lint": "eslint \"src/**/*.ts\" \"scripts/*.js\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"scripts/*.js\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.js\"",
    "gate:comments": "node scripts/gate-comments.js",
    "gate:comments:update": "node scripts/gate-comments.js --update",
    "gate:self": "node scripts/gate-self.js",
    "gate:self:warning": "node scripts/gate-self.js --severity warning",
    "gate:self:slice": "node scripts/gate-self-slice.js",
    "gate:self:slice:warning": "node scripts/gate-self-slice.js --severity warning",
    "gate:rust": "cargo clippy --manifest-path crates/Cargo.toml --workspace --exclude auto-refactor-core --all-targets -- -D warnings && cargo fmt --manifest-path crates/Cargo.toml --all -- --check && node scripts/test-rust.js",
    "test:rust": "node scripts/test-rust.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:native": "node scripts/validate-native-benchmark.js",
    "gate": "npm run gate:rust && npm run build && npm run format:check && npm run lint && npm run gate:comments && npm run gate:self && npm run gate:self:warning && npm test",
    "pretest": "npm run build",
    "test": "node scripts/test-parallel.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:parallel": "node scripts/test-parallel.js",
    "test:serial": "npm run validate && npm run validate-warm && npm run validate-oxc && npm run validate-diff && npm run validate-praxis && npm run validate-governance && npm run validate-generalized && npm run validate-review-memory && npm run validate-asymmetric && npm run validate-security && npm run validate-capabilities && npm run validate-language-support && npm run validate-language-matrix && npm run validate-python && npm run validate-comment-hygiene && npm run validate-simplify && npm run validate-python-modern && npm run validate-ts-modern && npm run validate-modern-packs && npm run validate-naming-suite && npm run validate-python-imports && npm run validate-postscan-parity && npm run validate-literal-policy && npm run validate-diff-interface && npm run validate-baseline-ratchet && npm run validate-suppression-gate && npm run validate-five-core-capabilities && npm run validate-rules-registry && npm run validate-symbol-index && npm run validate-rule-aliases && npm run validate-docs && npm run validate-project-neutrality && npm run validate-consumer-runner && npm run test-codec && npm run validate-compression && npm run validate-data-flow && npm run validate-self-norms && npm run validate-marker-scope",
    "validate-naming-suite": "node scripts/validate-naming-suite.js",
    "validate-physical-naming": "node scripts/validate-physical-naming.js",
    "validate-constants-ssot": "node scripts/validate-constants-ssot.js",
    "validate-i18n-cleanliness": "node scripts/validate-i18n-cleanliness.js",
    "validate-agent-actionable": "node scripts/validate-agent-actionable.js",
    "validate-expert-manifest": "node scripts/validate-expert-manifest.js",
    "validate-governance-exemptions": "node scripts/validate-governance-exemptions.js",
    "validate-fail-closed": "node scripts/validate-fail-closed.js",
    "validate-latency-metrics": "node scripts/validate-latency-metrics.js",
    "validate-scheduler-pools": "node scripts/validate-scheduler-pools.js",
    "validate-ring-buffer-bus": "node scripts/validate-ring-buffer-bus.js",
    "validate-topology-cache": "node scripts/validate-topology-cache.js",
    "validate-native-bridge": "node scripts/validate-native-bridge.js",
    "validate-native-benchmark": "node scripts/validate-native-benchmark.js",
    "validate-tensor-partitions": "node scripts/validate-tensor-partitions.js",
    "validate-agent-quota-gateway": "node scripts/validate-agent-quota-gateway.js",
    "validate-scalable-e2e": "node scripts/validate-scalable-e2e.js",
    "validate-role-inference": "node scripts/validate-role-inference.js",
    "validate-mit-corpus": "node scripts/validate-mit-corpus.js",
    "validate-config-driven-architecture": "node scripts/validate-config-driven-architecture.js",
    "validate-elastic-complexity-budget": "node scripts/validate-elastic-complexity-budget.js",
    "validate-function-cohesion-skeleton": "node scripts/validate-function-cohesion-skeleton.js",
    "validate-cognitive-cost-anti-gaming": "node scripts/validate-cognitive-cost-anti-gaming.js",
    "validate-static-quality-model": "node scripts/validate-static-quality-model.js",
    "validate-dynamic-quality-model": "node scripts/validate-dynamic-quality-model.js",
    "validate-risk-fusion-engine": "node scripts/validate-risk-fusion-engine.js",
    "validate-change-quality-arbiter": "node scripts/validate-change-quality-arbiter.js",
    "validate-feedback-adaptive-supervisor": "node scripts/validate-feedback-adaptive-supervisor.js",
    "validate-autonomy-scorer": "node scripts/validate-autonomy-scorer.js",
    "validate-data-flow": "node scripts/validate-data-flow.js && node scripts/validate-context-slice.js",
    "validate-self-norms": "node scripts/validate-self-norms.js && node scripts/validate-scoring-coverage.js && node scripts/validate-diff-score.js",
    "validate-marker-scope": "node scripts/validate-marker-scope.js",
    "validate-compression": "node scripts/validate-compression-bounds.js",
    "validate-language-support": "node scripts/validate-language-support.js",
    "validate-python": "node scripts/validate-python.js",
    "validate-comment-hygiene": "node scripts/validate-comment-hygiene.js",
    "validate-simplify": "node scripts/validate-simplify.js",
    "validate-python-modern": "node scripts/validate-python-modern.js",
    "validate-shadowing": "node scripts/validate-shadowing.js",
    "validate-python-imports": "node scripts/validate-python-imports.js",
    "validate-postscan-parity": "node scripts/validate-postscan-parity.js",
    "validate-diff-interface": "node scripts/validate-diff-interface.js",
    "validate-baseline-ratchet": "node scripts/validate-baseline-ratchet.js",
    "validate-five-core-capabilities": "node scripts/validate-five-core-capabilities.js",
    "validate-suppression-gate": "node scripts/validate-suppression-gate.js",
    "validate-rules-registry": "node scripts/validate-rules-registry.js",
    "validate-constant-governance": "node scripts/validate-constant-governance.js",
    "validate-docs": "node scripts/validate-docs.js",
    "validate-project-neutrality": "node scripts/validate-project-neutrality.js",
    "validate-consumer-runner": "node scripts/validate-consumer-runner.js",
    "validate-capabilities": "node scripts/validate-capabilities.js",
    "validate-security": "node scripts/validate-security-levels.js",
    "validate-asymmetric": "node scripts/validate-asymmetric-routing.js",
    "validate-baseline": "node scripts/validate-baseline-freeze.js",
    "validate-semantic-ir": "node scripts/validate-semantic-ir.js",
    "validate-language-adapters": "node scripts/validate-language-adapters.js",
    "validate-universal-rules": "node scripts/validate-universal-rules.js",
    "validate-performance-rules": "node scripts/validate-performance-rules.js",
    "validate-data-architecture": "node scripts/validate-data-architecture.js",
    "validate-test-modernity": "node scripts/validate-test-modernity.js",
    "validate-meta-architecture": "node scripts/validate-meta-architecture.js",
    "validate-quality-quantification": "node scripts/validate-quality-quantification.js",
    "validate-self-audit": "node scripts/validate-self-audit.js",
    "validate-self-refactor": "node scripts/validate-self-refactor.js",
    "self:audit": "node scripts/run-self-audit.js",
    "bench-asymmetric": "node scripts/bench-asymmetric.js",
    "validate-review-memory": "node scripts/validate-review-memory.js",
    "validate-generalized": "node scripts/validate-generalized.js",
    "validate-governance": "node scripts/validate-governance.js",
    "validate-praxis": "node scripts/validate-praxis-foundation.js",
    "start": "node dist/index.js",
    "demo": "node dist/index.js scan --root samples --format text",
    "validate": "node scripts/validate-equivalence.js",
    "validate-warm": "node scripts/validate-warm.js",
    "validate-oxc": "node scripts/validate-oxc-keypoints.js",
    "validate-diff": "node scripts/validate-diff.js",
    "hotpath-bench": "node scripts/bench-hot-paths.js",
    "hotpath-ablate": "node scripts/bench-hot-paths.js --ablate",
    "hotpath-baseline:update": "node scripts/bench-hot-paths.js --update",
    "bench-baselines": "node scripts/bench-baselines.js",
    "bench-warm": "node scripts/bench-warm.js",
    "bench-diff": "node scripts/bench-diff.js",
    "bench-quant": "node scripts/bench-quant.js",
    "bench-oxc-modea": "node scripts/bench-oxc-modea.js",
    "fastpath-check": "node scripts/bench-fastpath.js --check",
    "fastpath-bench": "node scripts/bench-fastpath.js",
    "test-codec": "node scripts/test-result-codec.js",
    "validate-literal-policy": "node scripts/validate-literal-policy.js",
    "validate-literal-policy-declarative": "node scripts/validate-literal-policy-declarative.js",
    "validate-self-slice-audit": "node scripts/validate-self-slice-audit.js",
    "validate-ts-modern": "node scripts/validate-ts-modern.js",
    "validate-modern-packs": "node scripts/validate-modern-packs.js",
    "validate-language-matrix": "node scripts/validate-language-matrix.js",
    "validate-rule-aliases": "node scripts/validate-rule-aliases.js",
    "validate-error-flow": "node scripts/validate-error-flow.js",
    "validate-symbol-index": "node scripts/validate-symbol-index.js && node scripts/validate-literal-index.js && node scripts/validate-call-graph.js && node scripts/validate-error-flow.js",
    "validate-nested-constant-cleanliness": "node scripts/validate-nested-constant-cleanliness.js",
    "validate-constant-library-topology": "node scripts/validate-constant-library-topology.js"
  },
  "keywords": [
    "refactoring",
    "static-analysis",
    "cyclomatic-complexity",
    "magic-number",
    "code-quality",
    "ci",
    "declarative"
  ],
  "license": "MIT",
  "dependencies": {
    "oxc-parser": "0.144.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "^0.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
